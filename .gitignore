# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
/backend/templates/~$fahrtenabrechnung_vorlage.xlsx

# Generierte Frontend-Builds gehoeren nicht ins Repository: der Dockerfile
# baut selbst (RUN npm run build). Eingecheckt erzeugten sie nur Rauschen in
# Diffs und in der statischen Analyse.
frontend/build/
backend/build/

# Lokale Umgebungsdateien (ergaenzend zu .env / .env.test weiter oben)
.env.local
.env.production
.env.*.local
stack.env

# Testartefakte
.playwright-mcp/

# Arbeitsdateien mit echten Personendaten (Namen, IBANs, Fahrten) — duerfen
# nie ins Repository
*.xlsx
Dienstfahrtenabrechnung*.pdf
*.png
!frontend/public/**/*.png
!frontend/src/**/*.png
# App-Icons und Splash-Screens der nativen Projekte. Ohne diese Ausnahmen
# verschluckt die *.png-Regel oben sie stillschweigend und der Build laesst
# sich auf keiner anderen Maschine reproduzieren.
!frontend/ios/**/*.png
!frontend/android/**/*.png

# --- Capacitor ---
# Kopierte Web-Assets: Duplikat von frontend/build/, gehoert nicht ins Repo.
frontend/ios/App/public/
frontend/android/app/src/main/assets/public/
frontend/ios/App/App/capacitor.config.json
frontend/android/app/src/main/assets/capacitor.config.json
frontend/android/app/src/main/assets/capacitor.plugins.json

# iOS
frontend/ios/App/Pods/
frontend/ios/DerivedData/
frontend/ios/App/output/
frontend/ios/.sourcekit-lsp/
xcuserdata/
*.xcuserdatad/

# Android
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/capacitor-cordova-android-plugins/
frontend/android/local.properties
frontend/android/.idea/

# Signing-Material gehoert nie ins Repository
*.keystore
!frontend/android/app/debug.keystore
*.p8
*.p12
*.mobileprovision
