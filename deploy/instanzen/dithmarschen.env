# Kirchenkreis Dithmarschen — die Referenzinstanz.
#
# Hier wird geprueft, bevor ein Stand an die anderen Kirchenkreise geht.
# Keine Zugangsdaten in dieser Datei: Passwoerter und Schluessel stehen in der
# stack.env auf dem Server selbst.

NAME="Kirchenkreis Dithmarschen"
HOST="root@185.248.143.234"
PFAD="/opt/fahrtenbuch"

# Zieht die fertigen Images von Docker Hub, die GitHub Actions gebaut hat.
MODUS="image"
COMPOSE_DATEI="docker-compose.yml"

# Der Server nutzt Compose v5 (ohne Bindestrich).
COMPOSE_BEFEHL="docker compose"

URL="https://kkd-fahrtenbuch.de"

# Vor dem Deploy wird die Datenbank gesichert — nur bei Instanzen mit echten
# Daten. Der Dump landet unter /opt/backups/vor-deploy/ auf dem Server.
DB_CONTAINER="fahrtenbuch-db-1"
DB_NAME="fahrtenbuch"
