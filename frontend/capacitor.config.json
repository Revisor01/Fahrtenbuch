{
  "appId": "de.godsapp.fahrtenbuch",
  "appName": "Fahrtenbuch",
  "webDir": "build",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0F5257",
    "scrollEnabled": false
  },
  "android": {
    "backgroundColor": "#0F5257"
