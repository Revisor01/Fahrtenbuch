<?xml version="1.0" encoding="utf-8"?>
<!-- Statische Kurzbefehle am App-Symbol, gleich wie in ios/App/App/Info.plist; ab Android 7.1. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="erfassen"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/kurzbefehl_erfassen_kurz"
        android:shortcutLongLabel="@string/kurzbefehl_erfassen_lang">
        <intent
            android:action="de.godsapp.fahrtenbuch.erfassen"
            android:targetPackage="de.godsapp.fahrtenbuch"
            android:targetClass="de.godsapp.fahrtenbuch.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="wiederholen"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/kurzbefehl_wiederholen_kurz"
        android:shortcutLongLabel="@string/kurzbefehl_wiederholen_lang">
        <intent
            android:action="de.godsapp.fahrtenbuch.wiederholen"
            android:targetPackage="de.godsapp.fahrtenbuch"
            android:targetClass="de.godsapp.fahrtenbuch.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

</shortcuts>
